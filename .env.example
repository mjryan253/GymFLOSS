# GymFLOSS configuration — copy to .env and edit:  cp .env.example .env
#
# The defaults below run a working instance on http://localhost:8080 with nothing changed.
# You only need to touch these to reach it from your phone over the internet, which requires
# an HTTPS hostname — see docs/SELF_HOSTING.md §3.

# Host port for the web UI. Read by docker-compose only, not by the app.
WEB_PORT=8080

# The hostname passkeys are bound to, and the full URL the app is served from. These must
# match the address in the browser's bar exactly, or WebAuthn refuses to verify — a mismatch
# is behind most "verification failed" reports.
#
# Browsers only allow passkeys over HTTPS, with http://localhost as the single exception. So
# another device on your LAN cannot use http://<lan-ip>:8080: that is neither HTTPS nor
# localhost, and no passkey prompt appears (guest mode still works).
#
# Changing RP_ID later invalidates every passkey already registered against the old
# hostname. Pick your domain before anyone creates a profile.
RP_ID=localhost
ORIGIN=http://localhost:8080

# Name shown in the passkey prompt.
RP_NAME=GymFLOSS

# Optional: admin dashboard. Comma-separated user ids, which you can read out of
# ./data/db.json under users[].id once you have registered your own profile.
# Empty means no admin exists and the instance stays open — the default.
ADMIN_UIDS=

# Optional: require an invite code to create a profile. Admins generate and revoke codes from
# the dashboard. Existing accounts keep working when you switch this on. Off unless set.
INVITE_ONLY=

# How long a session cookie stays valid, in days. 90 keeps someone who trains a few times a
# week permanently signed in without a stolen cookie being good for a year. The expiry is
# baked into each cookie as it is issued, so lowering this never cuts an existing session
# short. A family instance and one on the open internet don't want the same number.
SESSION_DAYS=90

# Contact identifier sent with Web Push, so a push service can reach whoever runs the
# instance about delivery problems. Defaults to ORIGIN over HTTPS, mailto:admin@localhost
# otherwise. A mailto: address you read is better than either.
VAPID_SUBJECT=

# Note: PORT and DATA_DIR are also read by the api, but docker-compose pins both
# (PORT=3000 internally, DATA_DIR=/data) — set them here and you will only break the
# nginx proxy or detach the data volume. Leave them to compose.
